{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2020"],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "ts/dist",
    "rootDir": "ts",
    "sourceMap": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["ts/**/*.ts"]
}